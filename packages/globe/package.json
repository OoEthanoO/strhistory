{
  "name": "@alexs-atlas/globe",
  "version": "0.1.0",
  "description": "Framework-agnostic MapLibre globe + bottom timeline for @alexs-atlas/borders, or just its border layers on an existing MapLibre map.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json --emitDeclarationOnly",
    "dev": "vite",
    "test": "vitest run",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@alexs-atlas/borders": "0.1.0"
  },
  "peerDependencies": {
    "maplibre-gl": "^6.11.2"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "playwright-core": "^1.63.0",
    "vite": "^8.3.0"
  }
}
