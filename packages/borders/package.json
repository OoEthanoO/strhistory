{
  "name": "@alexs-atlas/borders",
  "version": "0.1.0",
  "description": "Historical world borders (3400 BCE - present) as static, time-chunked TopoJSON plus an isomorphic query API (bordersAt(year)).",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./data/*": "./data/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "data",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "smoke": "node src/tools/smoke.mjs"
  },
  "dependencies": {
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "ajv": "^8.20.0",
    "mapshaper": "^0.7.72",
    "polylabel": "^2.1.0",
    "topojson-server": "^3.0.1"
  }
}
