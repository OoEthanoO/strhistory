# Caddy site block for the history site on the home server.
#
# This file is the source of truth. On every deploy, deploy/server/deploy.ps1
# copies it to C:\Users\ethan\strhistory\Caddyfile (the copy the server's main
# Caddyfile imports), validates the whole Caddy config, and reloads Caddy. An
# invalid change is rolled back automatically and reported in the deploy log.
#
# Caddy obtains and renews the HTTPS certificate itself once DNS for the domain
# points at the server.

history.ethanyanxu.com {
	encode zstd gzip

	# `current` is a junction to the live release (releases\<commit>).
	root * C:/Users/ethan/strhistory/current

	# GeoJSON has no registered type in Caddy; serve it as JSON so it is
	# compressed (the snapshot files shrink ~4x).
	@geojson path *.geojson
	header @geojson Content-Type "application/json; charset=utf-8"

	# Fingerprinted build assets never change; data files change rarely.
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@data {
		path /data/* /glyphs/*
		not path /data/alexs-atlas/*
	}
	header @data Cache-Control "public, max-age=86400"
	# The Alex's Atlas borders dataset: manifest.json names every other file by
	# content hash, so the manifest is revalidated and the hashed files never change.
	@atlasUnhashed {
		path /data/alexs-atlas/*
		not path_regexp ^/data/alexs-atlas/.+\.[0-9a-f]{8}(\.topo)?\.json$
	}
	header @atlasUnhashed Cache-Control "no-cache"
	@atlasHashed path_regexp atlasHashed ^/data/alexs-atlas/.+\.[0-9a-f]{8}(\.topo)?\.json$
	header @atlasHashed Cache-Control "public, max-age=31536000, immutable"
	@version path /version.json
	header @version Cache-Control "no-store"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Explicit public surface. Everything else (including / and direct .html
	# URLs) requires a signed session before Caddy reads the file.
	@publicPage path /globe /globe/ /globe/index.html /access /access/ /access/index.html /favicon.svg /robots.txt /sitemap-index.xml /sitemap-0.xml /version.json
	@publicAsset path_regexp publicAsset ^(/_astro/[^/]+\.(js|css|woff2|woff|svg|png|jpg|jpeg|webp|avif)|/data/land\.geojson|/data/snapshots/world_-?[0-9]+\.geojson|/data/snapshots/LICENSE\.md|/glyphs/noto-sans/[0-9]+-[0-9]+\.pbf|/data/alexs-atlas/(?:(?:chunks/l[0-9]+|base)/)?[a-z0-9_-]+(?:\.[a-z0-9_-]+)*\.json|/data/alexs-atlas/(?:ATTRIBUTION|LICENSE)\.md)$
	@accessAction path /access/unlock /access/logout /access/session
	route {
		handle @accessAction {
			reverse_proxy 127.0.0.1:4310 {
				header_up X-Access-Client {remote_host}
			}
		}
		handle @publicPage {
			header Cache-Control "no-store"
			file_server
		}
		handle @publicAsset {
			file_server
		}
		handle {
			header Cache-Control "private, no-store"
			header X-Robots-Tag "noindex, nofollow"
			forward_auth 127.0.0.1:4310 {
				uri /verify
			}
			file_server
		}
	}

	handle_errors {
		@notfound expression {err.status_code} == 404
		handle @notfound {
			# Never let a missing hashed file inherit its path's year-long cache.
			header Cache-Control "no-store"
			rewrite * /404.html
			file_server
		}
	}

	log {
		output file C:/Users/ethan/strhistory/logs/access.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}
