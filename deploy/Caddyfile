# Caddy site block for the history site on the home server.
#
# This file is the source of truth. On every deploy, deploy/server/deploy.ps1
# copies it to C:\Users\ethan\strhistory\Caddyfile (the copy the server's main
# Caddyfile imports), validates the whole Caddy config, and reloads Caddy. An
# invalid change is rolled back automatically and reported in the deploy log.
#
# Caddy obtains and renews the HTTPS certificate itself once DNS for the domain
# points at the server.

history.ethanyanxu.com {
	encode zstd gzip

	# `current` is a junction to the live release (releases\<commit>).
	root * C:/Users/ethan/strhistory/current

	# GeoJSON has no registered type in Caddy; serve it as JSON so it is
	# compressed (the snapshot files shrink ~4x).
	@geojson path *.geojson
	header @geojson Content-Type "application/json; charset=utf-8"

	# Fingerprinted build assets never change; data files change rarely.
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@data path /data/* /glyphs/*
	header @data Cache-Control "public, max-age=86400"
	@version path /version.json
	header @version Cache-Control "no-store"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	file_server

	handle_errors {
		@notfound expression {err.status_code} == 404
		handle @notfound {
			rewrite * /404.html
			file_server
		}
	}

	log {
		output file C:/Users/ethan/strhistory/logs/access.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}
