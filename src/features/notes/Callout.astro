---
/**
 * <Callout type="exam" title="Optional title">Markdown content</Callout>
 *
 * Types: exam (exam technique), historiography (historians' debate),
 * context (background), warning (common mistake), tip.
 */
import './notes.css';

type CalloutType = 'exam' | 'historiography' | 'context' | 'warning' | 'tip';

interface Props {
  type?: CalloutType;
  title?: string;
}

const defaults: Record<CalloutType, string> = {
  exam: 'Exam focus',
  historiography: "Historians' debate",
  context: 'Context',
  warning: 'Common mistake',
  tip: 'Study tip',
};

const icons: Record<CalloutType, string> = {
  exam: 'M4 5h16v14H4zM8 9h8M8 13h5',
  historiography: 'M5 4h9l5 5v11H5zM14 4v5h5M8 13h8M8 17h6',
  context: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm0 5v.01M11 11h1v6h1',
  warning: 'M12 3 2 20h20L12 3Zm0 6v5m0 3v.01',
  tip: 'M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2.1h5c0-.9.4-1.6 1-2.1A6 6 0 0 0 12 3Z',
};

const { type = 'context', title } = Astro.props;
---

<aside class={`note-callout note-callout--${type}`}>
  <p class="note-callout__title">
    <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
      <path d={icons[type]} fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
    {title ?? defaults[type]}
  </p>
  <div class="note-callout__body"><slot /></div>
</aside>
