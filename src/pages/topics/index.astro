---
import Badge from '@/components/Badge.astro';
import PageHeader from '@/components/PageHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTopics, getUnits } from '@/lib/content';
import { formatYearRange } from '@/lib/format';

const topics = await getTopics();
const units = await getUnits();

const papers = [
  { paper: 1, name: 'Paper 1 — Prescribed subjects', note: 'Source-based. Your school studies one prescribed subject.' },
  { paper: 2, name: 'Paper 2 — World history topics', note: 'Two essays, each on a different world history topic.' },
  { paper: 3, name: 'Paper 3 — HL regional options', note: 'Higher Level only. Three essays on one region.' },
].map((p) => ({
  ...p,
  units: units
    .filter((u) => u.data.paper === p.paper)
    .map((u) => ({ unit: u, topics: topics.filter((t) => t.data.unit.id === u.id) })),
}));
---

<BaseLayout
  title="Study notes"
  description="IB History study notes organised by exam paper and syllabus unit, with interactive key terms and quotes."
>
  <PageHeader
    eyebrow="Study notes"
    title="Every topic, by exam paper"
    lede="Notes follow the IB History syllabus. Each topic is also a pin on the globe — open it there to see the world as it was."
  >
    <div class="tools">
      <label class="search">
        <span class="visually-hidden">Filter topics</span>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
          ><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8"></circle><path
            d="m16 16 4.5 4.5"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"></path></svg
        >
        <input type="search" placeholder="Filter by name, place or year…" data-filter autocomplete="off" />
      </label>
      <nav class="jump" aria-label="Jump to paper">
        {papers.map((p) => <a href={`#paper-${p.paper}`}>Paper {p.paper}</a>)}
        <a href="/globe">Open the globe →</a>
      </nav>
    </div>
  </PageHeader>

  <div class="container papers">
    {
      papers.map((p) => (
        <section class="paper" id={`paper-${p.paper}`} aria-labelledby={`paper-${p.paper}-title`}>
          <div class="paper-head">
            <h2 id={`paper-${p.paper}-title`}>{p.name}</h2>
            <p class="muted">{p.note}</p>
          </div>
          <div class="units">
            {p.units.map(({ unit, topics }) => (
              <div class="unit" data-unit>
                <div class="unit-head">
                  <p class="unit-component">{unit.data.component}</p>
                  <h3>{unit.data.title}</h3>
                  <p class="unit-desc">{unit.data.description}</p>
                </div>
                {topics.length ? (
                  <ul class="topic-list">
                    {topics.map((t) => (
                      <li
                        data-topic
                        data-text={`${t.data.title} ${t.data.location.place} ${t.data.period.start} ${t.data.period.end} ${t.data.summary} ${unit.data.title}`.toLowerCase()}
                      >
                        <a href={`/topics/${t.id}`}>
                          <span class="t-title">{t.data.title}</span>
                          <span class="t-meta">
                            {formatYearRange(t.data.period.start, t.data.period.end)} · {t.data.location.place}
                          </span>
                        </a>
                        {t.data.draft && <Badge tone="sample">Draft</Badge>}
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="empty">Notes for this unit are coming soon.</p>
                )}
              </div>
            ))}
          </div>
        </section>
      ))
    }
    <p class="no-results" hidden data-no-results>No topics match that filter.</p>
  </div>
</BaseLayout>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-filter]');
  const items = [...document.querySelectorAll<HTMLElement>('[data-topic]')];
  const units = [...document.querySelectorAll<HTMLElement>('[data-unit]')];
  const none = document.querySelector<HTMLElement>('[data-no-results]');
  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let shown = 0;
    for (const li of items) {
      const hit = !q || li.dataset.text!.includes(q);
      li.hidden = !hit;
      if (hit) shown++;
    }
    for (const u of units) {
      const anyTopics = u.querySelector('[data-topic]');
      u.hidden = !!q && (!anyTopics || !u.querySelector('[data-topic]:not([hidden])'));
    }
    if (none) none.hidden = shown > 0;
  });
</script>

<style>
  .tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    margin-top: 28px;
  }
  .search {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1 1 320px;
    max-width: 480px;
    padding: 10px 16px;
    border-radius: 999px;
    border: 1px solid var(--rule-strong);
    background: var(--card);
    color: var(--ink-3);
  }
  .search:focus-within {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  .search input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    font: inherit;
    color: var(--ink);
    outline: none;
  }
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .jump a {
    text-decoration: none;
  }
  .jump a:hover {
    text-decoration: underline;
  }

  .papers {
    padding-bottom: clamp(48px, 7vw, 96px);
  }
  .paper + .paper {
    margin-top: clamp(48px, 6vw, 80px);
  }
  .paper-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 24px;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--ink);
    margin-bottom: 8px;
  }
  .paper-head h2 {
    margin: 0;
  }
  .paper-head p {
    margin: 0;
  }
  .units {
    display: grid;
  }
  .unit {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    gap: 12px 40px;
    padding: 24px 0;
    border-bottom: 1px solid var(--rule);
  }
  .unit[hidden] {
    display: none;
  }
  .unit-component {
    margin: 0 0 4px;
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brass);
  }
  .unit h3 {
    font-size: 1.35rem;
    margin-bottom: 6px;
  }
  .unit-desc {
    margin: 0;
    font-size: 0.93rem;
    color: var(--ink-2);
  }
  .topic-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .topic-list li {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .topic-list li[hidden] {
    display: none;
  }
  .topic-list a {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 12px 16px;
    border-radius: var(--radius);
    border: 1px solid var(--rule);
    background: var(--card);
    text-decoration: none;
    color: var(--ink);
    transition: border-color 0.15s, transform 0.15s;
  }
  .topic-list a:hover {
    border-color: var(--accent);
    transform: translateX(3px);
    color: var(--ink);
  }
  .t-title {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 560;
  }
  .t-meta {
    font-size: 0.85rem;
    color: var(--ink-3);
  }
  .empty {
    margin: 0;
    align-self: center;
    font-size: 0.92rem;
    color: var(--ink-3);
    font-style: italic;
  }
  .no-results {
    padding: 40px 0;
    text-align: center;
    color: var(--ink-3);
  }
  @media (max-width: 760px) {
    .unit {
      grid-template-columns: 1fr;
    }
  }
</style>
