---
import { getEntries, getEntry, render } from 'astro:content';
import Badge from '@/components/Badge.astro';
import TopicCard from '@/components/TopicCard.astro';
import { notesComponents } from '@/features/notes';
import '@/features/notes/notes.css';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTerm, getTopics, snapshotYearFor, termIdsIn, type Topic } from '@/lib/content';
import { formatDate, formatYear, formatYearRange } from '@/lib/format';

export async function getStaticPaths() {
  const topics = await getTopics();
  return topics.map((topic) => ({ params: { slug: topic.id }, props: { topic } }));
}

interface Props {
  topic: Topic;
}

const { topic } = Astro.props;
const { data } = topic;
const { Content } = await render(topic);
const unit = await getEntry(data.unit);
const related = await getEntries(data.related);
const authors = await getEntries(data.authors);
const snapshot = snapshotYearFor(topic);
const terms = await Promise.all(termIdsIn(topic.body ?? '').map((id) => getTerm(id)));
terms.sort((a, b) => a.data.term.localeCompare(b.data.term));
const isG10 = data.curriculum === 'grade-10';
const collectionQuery = isG10 ? `curriculum=grade-10` : `curriculum=${data.curriculum}&level=${data.level ?? 'SL'}`;
const libraryHref = `/topics?${collectionQuery}`;
const globeHref = `/globe?year=${snapshot}&topic=${topic.id}&${collectionQuery}`;
---

<BaseLayout title={data.title} description={data.summary}>
  <div class="reading-progress" aria-hidden="true"><span data-reading-bar></span></div>

  <header class="topic-hero">
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={libraryHref} data-course-link data-required-level={isG10 ? undefined : data.level}>Notes</a>
        <span aria-hidden="true">/</span>
        {isG10 ? (
          <a href={libraryHref} data-course-link>Grade 10</a>
        ) : (
          <a href={`${libraryHref}#paper-${unit.data.paper}`} data-course-link data-required-level={data.level}>Paper {unit.data.paper}</a>
        )}
        <span aria-hidden="true">/</span>
        <span>{unit.data.title}</span>
      </nav>
      <h1>{data.title}</h1>
      <div class="meta">
        {isG10 ? (
          <Badge tone="paper-1">Grade 10</Badge>
        ) : (
          <>
            <Badge tone={`paper-${unit.data.paper}`}>Paper {unit.data.paper}</Badge>
            {data.level && <Badge>{data.level === 'HL' ? 'HL only' : 'SL & HL'}</Badge>}
          </>
        )}
        <span class="meta-item">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"
            ><rect x="3.5" y="5" width="17" height="15" rx="2" fill="none" stroke="currentColor" stroke-width="1.7"
            ></rect><path d="M3.5 10h17M8 3v4M16 3v4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"
            ></path></svg
          >
          {formatYearRange(data.period.start, data.period.end)}
        </span>
        <span class="meta-item">
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"
            ><path
              d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"></path><circle cx="12" cy="10" r="2.3" fill="none" stroke="currentColor" stroke-width="1.7"
            ></circle></svg
          >
          {data.location.place}
        </span>
      </div>
      <p class="lede">{data.summary}</p>
      {data.curriculum === 'archive' && <p class="archive-notice">Archived study notes from the earlier syllabus. This topic is outside the department’s selected 2028 course. <a href="/topics?curriculum=2028">Browse the current notes.</a></p>}
      <div class="hero-actions">
        <a class="btn btn--primary" href={globeHref} data-course-link data-required-level={isG10 ? undefined : data.level}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
            ><circle cx="12" cy="12" r="8.5" fill="none" stroke="currentColor" stroke-width="1.7"></circle><path
              d="M3.5 12h17M12 3.5c2.6 2.3 3.7 5.3 3.7 8.5s-1.1 6.2-3.7 8.5c-2.6-2.3-3.7-5.3-3.7-8.5s1.1-6.2 3.7-8.5Z"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"></path></svg
          >
          Find this note in {formatYear(snapshot)}
        </a>
      </div>
      {
        data.keyQuestions.length > 0 && (
          <section class="key-questions" aria-labelledby="kq-title">
            <h2 id="kq-title">Key questions</h2>
            <ol>
              {data.keyQuestions.map((q) => (
                <li>{q}</li>
              ))}
            </ol>
          </section>
        )
      }
    </div>
  </header>

  <div class="container topic-body">
    <article class="prose topic-notes">
      <Content components={notesComponents} />

      {
        terms.length > 0 && (
          <section class="term-index" aria-labelledby="key-terms">
            <h2 id="key-terms">Key terms</h2>
            <dl>
              {terms.map((t) => (
                <div class="term-row" id={`term-${t.id}`}>
                  <dt>
                    {t.data.term}
                    {t.data.when && <span class="term-when">{t.data.when}</span>}
                  </dt>
                  <dd>
                    <p>{t.data.definition}</p>
                    <p class="term-sig">
                      <strong>Significance:</strong> {t.data.significance}
                    </p>
                  </dd>
                </div>
              ))}
            </dl>
          </section>
        )
      }

      <footer class="topic-foot">
        {
          authors.length > 0 && (
            <p>
              Notes by{' '}
              {authors.map((a, i) => (
                <>
                  {i > 0 && ', '}
                  <a href={`/teachers/${a.id}`}>{a.data.name}</a>
                </>
              ))}
              .
            </p>
          )
        }
        {data.updated && <p>Last updated {formatDate(data.updated)}.</p>}
      </footer>
    </article>
  </div>

  {
    related.length > 0 && (
      <section class="section related">
        <div class="container">
          <h2>Related notes</h2>
          <div class="grid" style="--min: 300px">
            {related.map((r) => (
              <TopicCard topic={r} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<script>
  // Keep the student's chosen course level when returning from a shared note.
  let savedLevel: string | null = null;
  try { savedLevel = localStorage.getItem('history-level'); } catch { /* Storage is optional. */ }
  const requestedLevel = new URLSearchParams(window.location.search).get('level');
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-course-link]')) {
    const level = link.dataset.requiredLevel === 'HL' || (requestedLevel ?? savedLevel) === 'HL' ? 'HL' : 'SL';
    const url = new URL(link.href);
    url.searchParams.set('level', level);
    link.href = url.href;
  }

  // Reading progress bar.
  const bar = document.querySelector<HTMLElement>('[data-reading-bar]');
  const article = document.querySelector<HTMLElement>('.topic-notes');
  const onScroll = () => {
    if (!bar || !article) return;
    const r = article.getBoundingClientRect();
    const total = r.height - window.innerHeight * 0.6;
    const done = Math.min(1, Math.max(0, -r.top / Math.max(1, total)));
    bar.style.transform = `scaleX(${done})`;
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    z-index: 60;
    pointer-events: none;
  }
  .reading-progress span {
    display: block;
    height: 100%;
    background: var(--accent);
    transform-origin: left;
    transform: scaleX(0);
  }

  .topic-hero {
    padding-top: clamp(32px, 5vw, 56px);
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 0.88rem;
    color: var(--ink-3);
    margin-bottom: 18px;
  }
  .crumbs a {
    color: var(--ink-2);
    text-decoration: none;
  }
  .crumbs a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .topic-hero h1 {
    max-width: 22ch;
    font-size: var(--step-4);
    margin-bottom: 16px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 20px;
    font-size: 0.95rem;
    color: var(--ink-2);
    margin-bottom: 20px;
  }
  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .meta-item svg {
    color: var(--ink-3);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }
  .archive-notice {
    max-width: 72ch;
    padding: 14px 18px;
    border-radius: var(--radius);
    background: var(--brass-soft);
    color: var(--ink-2);
    font-size: 0.92rem;
  }
  .key-questions {
    margin-top: 32px;
    padding: 18px 22px;
    border-radius: var(--radius-l);
    background: var(--accent-soft);
  }
  .key-questions h2 {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 8px;
  }
  .key-questions ol {
    margin: 0;
    padding-left: 1.3em;
    font-family: var(--font-display);
    font-size: 1.1rem;
  }
  .key-questions li {
    margin-bottom: 4px;
  }

  .topic-hero .container,
  .topic-body {
    max-width: calc(var(--prose) + 2 * var(--gutter));
  }
  .topic-body {
    padding-block: clamp(32px, 4vw, 48px) clamp(48px, 6vw, 80px);
  }

  .term-index {
    margin-top: 3em;
  }
  .term-index dl {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.95rem;
  }
  .term-row {
    padding: 14px 18px;
    margin-bottom: 8px;
    border-radius: var(--radius);
    background: var(--term-soft);
  }
  .term-row dt {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.08rem;
  }
  .term-when {
    margin-left: 8px;
    font-family: var(--font-sans);
    font-weight: 500;
    font-size: 0.8rem;
    color: var(--ink-3);
  }
  .term-row dd {
    margin: 4px 0 0;
    color: var(--ink-2);
  }
  .term-row dd p {
    margin: 0 0 6px;
  }
  .term-sig strong {
    color: var(--term);
  }
  .related {
    padding-top: 0;
  }
  .related h2 {
    font-size: var(--step-2);
  }
  .topic-foot {
    margin-top: 3em;
    font-family: var(--font-sans);
    font-size: 0.88rem;
    color: var(--ink-3);
  }
  .topic-foot p {
    margin-bottom: 6px;
  }

</style>
