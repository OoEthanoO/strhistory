---
import { getCollection } from 'astro:content';
import Badge from '@/components/Badge.astro';
import HeroGlobe from '@/components/HeroGlobe.astro';
import NewsCard from '@/components/NewsCard.astro';
import TeacherCard from '@/components/TeacherCard.astro';
import TopicCard from '@/components/TopicCard.astro';
import { site } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCourses, getNews, getSnapshots, getTeachers, getTopics, getUnits } from '@/lib/content';

const topics = await getTopics();
const snapshots = await getSnapshots();
const units = await getUnits();
const glossary = await getCollection('glossary');
const courses = await getCourses();
const teachers = (await getTeachers()).slice(0, 4);
const news = (await getNews()).slice(0, 3);

// A spread of topics across the timeline for the "featured" row.
const featured = [...topics].sort((a, b) => b.data.period.start - a.data.period.start).filter((_, i) => i % 2 === 0).slice(0, 6);

const papers = [1, 2, 3].map((paper) => {
  const paperUnits = units.filter((u) => u.data.paper === paper);
  const count = topics.filter((t) => paperUnits.some((u) => u.id === t.data.unit.id)).length;
  return { paper, units: paperUnits, count };
});
const paperInfo: Record<number, { name: string; blurb: string }> = {
  1: { name: 'Prescribed subjects', blurb: 'Source-based case studies. Read, compare and evaluate evidence.' },
  2: { name: 'World history topics', blurb: 'Essays that compare events and themes across regions.' },
  3: { name: 'HL regional options', blurb: 'Depth studies of one region for Higher Level students.' },
};
const first = snapshots[0]?.data.year;
const last = snapshots.at(-1)?.data.year;
---

<BaseLayout>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow hero-eyebrow">{site.department}</p>
        <h1>History, <em>mapped.</em></h1>
        <p class="hero-lede">
          Spin the globe to any year from {first} to {last}, see the world's borders as they were, and click a pin to
          open study notes for that IB History topic.
        </p>
        <div class="hero-actions">
          <a class="btn btn--primary btn--lg" href="/globe">
            Explore the globe
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
              ><path
                d="M5 12h13m-5-6 6 6-6 6"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path></svg
            >
          </a>
          <a class="btn btn--lg btn--ghost" href="/topics">Browse the notes</a>
        </div>
        <dl class="stats">
          <div><dt>IB topics</dt><dd>{topics.length}</dd></div>
          <div><dt>Key terms</dt><dd>{glossary.length}</dd></div>
          <div><dt>Map snapshots</dt><dd>{snapshots.length}</dd></div>
        </dl>
      </div>
      <a class="hero-art" href="/globe" aria-label="Open the interactive globe">
        <HeroGlobe topics={topics} />
      </a>
    </div>
  </section>

  <section class="section how">
    <div class="container">
      <p class="eyebrow">How it works</p>
      <h2>From a place on the map to a page of notes</h2>
      <ol class="steps">
        <li>
          <span class="step-n">1</span>
          <h3>Pick a year</h3>
          <p>
            Drag the timeline to a snapshot. The globe redraws the empires and states of that moment, coloured by who
            controlled them.
          </p>
        </li>
        <li>
          <span class="step-n">2</span>
          <h3>Click a pin</h3>
          <p>
            Lit pins are the IB topics of that era. Hover for a preview, click to open the notes. Faint pins take you to
            their own era.
          </p>
        </li>
        <li>
          <span class="step-n">3</span>
          <h3>Study actively</h3>
          <p>
            Key quotes are highlighted. Click any <span class="demo-term">key term</span> to see why it matters, then
            test yourself at the end.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Study notes</p>
          <h2>Featured topics</h2>
        </div>
        <a class="more" href="/topics">All {topics.length} topics →</a>
      </div>
      <div class="grid" style="--min: 300px">
        {featured.map((t) => <TopicCard topic={t} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">The IB History course</p>
      <h2>Notes organised by exam paper</h2>
      <div class="papers">
        {
          papers.map(({ paper, units, count }) => (
            <a class="paper" href={`/topics#paper-${paper}`}>
              <Badge tone={`paper-${paper}`}>Paper {paper}</Badge>
              <h3>{paperInfo[paper].name}</h3>
              <p>{paperInfo[paper].blurb}</p>
              <p class="paper-meta">
                {units.length} units · {count} {count === 1 ? 'topic' : 'topics'} with notes
              </p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container dept">
      <div>
        <p class="eyebrow">The department</p>
        <h2>Courses</h2>
        <ul class="course-list">
          {
            courses.map((c) => (
              <li>
                <a href={`/courses/${c.id}`}>
                  <span class="course-title">{c.data.title}</span>
                  <span class="course-meta">
                    {c.data.level} · {c.data.grades}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
        <a class="more" href="/courses">Courses and the IB syllabus →</a>
      </div>
      <div>
        <div class="section-head">
          <h2>Teachers</h2>
          <a class="more" href="/teachers">Meet the department →</a>
        </div>
        <div class="grid" style="--min: 220px">
          {teachers.map((t) => <TeacherCard teacher={t} compact />)}
        </div>
      </div>
    </div>
  </section>

  {
    news.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="section-head">
            <div>
              <p class="eyebrow">News</p>
              <h2>From the department</h2>
            </div>
            <a class="more" href="/news">All news →</a>
          </div>
          <div class="grid" style="--min: 300px">
            {news.map((n) => (
              <NewsCard post={n} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(ellipse 60% 70% at 75% 45%, rgb(40 64 110 / 0.55), transparent 70%),
      radial-gradient(ellipse 40% 50% at 10% 100%, rgb(142 44 50 / 0.25), transparent 70%),
      var(--night);
    color: var(--night-ink);
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(1px 1px at 12% 22%, rgb(255 255 255 / 0.6), transparent 60%),
      radial-gradient(1px 1px at 42% 12%, rgb(255 255 255 / 0.45), transparent 60%),
      radial-gradient(1px 1px at 88% 18%, rgb(255 255 255 / 0.55), transparent 60%),
      radial-gradient(1px 1px at 64% 86%, rgb(255 255 255 / 0.4), transparent 60%),
      radial-gradient(1px 1px at 28% 72%, rgb(255 255 255 / 0.35), transparent 60%);
    background-size: 380px 380px, 420px 420px, 360px 360px, 440px 440px, 400px 400px;
    pointer-events: none;
  }
  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(24px, 5vw, 64px);
    padding-block: clamp(48px, 8vw, 104px);
  }
  .hero-eyebrow {
    color: #f2b35b;
  }
  .hero h1 {
    font-size: clamp(3rem, 2rem + 5vw, 6rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
    margin-bottom: 24px;
    color: #fff;
  }
  .hero h1 em {
    font-style: italic;
    color: #f2b35b;
  }
  .hero-lede {
    font-family: var(--font-serif);
    font-size: var(--step-1);
    line-height: 1.5;
    color: rgb(233 228 216 / 0.82);
    max-width: 34em;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  .hero .btn--primary {
    background: #f2b35b;
    border-color: #f2b35b;
    color: #1c1204;
  }
  .hero .btn--primary:hover {
    background: #f7c679;
    border-color: #f7c679;
    color: #1c1204;
  }
  .btn--ghost {
    background: transparent;
    border-color: rgb(255 255 255 / 0.25);
    color: #fff;
  }
  .btn--ghost:hover {
    border-color: rgb(255 255 255 / 0.6);
    color: #fff;
  }
  .stats {
    display: flex;
    gap: clamp(20px, 4vw, 48px);
    margin: 44px 0 0;
    padding-top: 24px;
    border-top: 1px solid rgb(255 255 255 / 0.12);
  }
  .stats div {
    display: flex;
    flex-direction: column-reverse;
  }
  .stats dt {
    font-size: 0.85rem;
    color: rgb(233 228 216 / 0.6);
  }
  .stats dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 2.2rem;
    line-height: 1.1;
    color: #fff;
  }
  .hero-art {
    display: block;
    max-width: 560px;
    justify-self: center;
    width: 100%;
    transition: transform 0.6s var(--ease);
  }
  .hero-art:hover {
    transform: scale(1.02) rotate(-1deg);
  }

  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 28px;
  }
  .section-head h2 {
    margin: 0;
  }
  .more {
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }
  .more:hover {
    text-decoration: underline;
  }

  .steps {
    list-style: none;
    padding: 0;
    margin: 36px 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 40px);
  }
  .steps li {
    position: relative;
    padding-top: 8px;
  }
  .step-n {
    display: inline-grid;
    place-items: center;
    width: 40px;
    height: 40px;
    margin-bottom: 14px;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 600;
  }
  .steps h3 {
    font-size: 1.4rem;
    margin-bottom: 8px;
  }
  .steps p {
    color: var(--ink-2);
  }
  .demo-term {
    color: var(--term);
    text-decoration: underline dotted 1.5px;
    text-underline-offset: 0.2em;
  }

  .papers {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 32px;
  }
  .paper {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    padding: 24px;
    border-radius: var(--radius-l);
    border: 1px solid var(--rule);
    background: var(--card);
    color: var(--ink);
    text-decoration: none;
    transition: transform 0.2s var(--ease), box-shadow 0.2s;
  }
  .paper:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
    color: var(--ink);
  }
  .paper h3 {
    margin: 8px 0 0;
    font-size: 1.5rem;
  }
  .paper p {
    margin: 0;
    color: var(--ink-2);
  }
  .paper .paper-meta {
    margin-top: auto;
    padding-top: 12px;
    font-size: 0.88rem;
    color: var(--ink-3);
  }

  .dept {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    gap: clamp(32px, 5vw, 72px);
  }
  .course-list {
    list-style: none;
    margin: 20px 0 20px;
    padding: 0;
    border-top: 1px solid var(--rule);
  }
  .course-list a {
    display: flex;
    flex-direction: column;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    color: var(--ink);
  }
  .course-list a:hover .course-title {
    color: var(--accent);
  }
  .course-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 560;
  }
  .course-meta {
    font-size: 0.88rem;
    color: var(--ink-3);
  }

  @media (max-width: 900px) {
    .hero-inner,
    .dept {
      grid-template-columns: 1fr;
    }
    .hero-art {
      max-width: 420px;
      order: -1;
    }
    .steps,
    .papers {
      grid-template-columns: 1fr;
    }
  }
</style>
