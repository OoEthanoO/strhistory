---
import NewsCard from '@/components/NewsCard.astro';
import TeacherCard from '@/components/TeacherCard.astro';
import HomeGlobe from '@/features/globe/HomeGlobe';
import { getGlobeData } from '@/features/globe/data';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCourses, getNews, getTeachers, getTopics, getUnits } from '@/lib/content';
import { formatYearRange } from '@/lib/format';
const data = await getGlobeData();
const topics = (await getTopics()).filter(t => t.data.curriculum === '2028');
const units = await getUnits();
const courses = await getCourses();
const teachers = (await getTeachers()).slice(0, 3);
const news = (await getNews()).slice(0, 3);
const previews = topics.filter(t => t.data.period.start === 1789).slice(0, 2);
const paperOf = (t: (typeof topics)[number]) => units.find(u => u.id === t.data.unit.id)?.data.paper;
const papers = [
  { paper: 1, title: 'Political and economic transitions', level: 'SL & HL' },
  { paper: 2, title: 'Authoritarian rule', level: 'SL & HL' },
  { paper: 3, title: 'Europe: revolution & unification', level: 'HL' },
].map(p => ({ ...p, notes: topics.filter(t => paperOf(t) === p.paper) }));
---
<BaseLayout>
  <section class="hero container">
    <h1>Every event has <span class="mark">a place<svg viewBox="0 0 200 12" preserveAspectRatio="none" aria-hidden="true"><path d="M3 9C45 3 95 2 130 5s52 5 67 1" /></svg></span></h1>
    <p>IB History study notes, pinned to where and when they happened.</p>
    <div class="hero-grid">
      <HomeGlobe client:load {...data} />
      <aside class="discovery" aria-labelledby="discovery-title">
        <h2 id="discovery-title">On the globe in 1789</h2>
        <div class="previews">
          {previews.map(t => <a class="preview" href={`/topics/${t.id}`}><span class="preview-meta">{t.data.location.place} · {formatYearRange(t.data.period.start, t.data.period.end)}</span><h3>{t.data.shortTitle ?? t.data.title}</h3><p>{t.data.summary}</p></a>)}
        </div>
        <a class="more" href="/topics">All notes →</a>
      </aside>
    </div>
  </section>

  <section class="section container">
    <div class="section-head"><h2>Course notes</h2><a class="more" href="/topics">Search all notes →</a></div>
    <div class="papers">
      {papers.map(p => (
        <div class={`paper paper--${p.paper}`}>
          <p class="paper-top"><span>Paper {p.paper}</span><span>{p.level}</span></p>
          <h3>{p.title}</h3>
          <ul>{p.notes.map(t => <li><a href={`/topics/${t.id}`}><span>{t.data.shortTitle ?? t.data.title}</span><span>{formatYearRange(t.data.period.start, t.data.period.end)}</span></a></li>)}</ul>
          <a class="more" href={`/topics?level=${p.paper === 3 ? 'HL' : 'SL'}#paper-${p.paper}`}>View in library →</a>
        </div>
      ))}
    </div>
    <p class="source">Course structure: <a href="https://ibo.org/globalassets/new-structure/programmes/dp/pdfs/dp-history-sb-en.pdf">IB History subject brief, first assessment 2028</a>.</p>
  </section>

  <section class="section container dept">
    <div>
      <div class="section-head"><h2>Courses</h2><a class="more" href="/courses">All courses →</a></div>
      <ul class="course-list">{courses.map(c => <li><a href={`/courses/${c.id}`}><span>{c.data.title}</span><span>{c.data.level} · {c.data.grades}{c.data.placeholder ? ' · Sample' : ''}</span></a></li>)}</ul>
    </div>
    <div>
      <div class="section-head"><h2>Teachers</h2><a class="more" href="/teachers">All teachers →</a></div>
      <div class="grid" style="--min: 260px">{teachers.map(t => <TeacherCard teacher={t} compact />)}</div>
    </div>
  </section>

  {news.length > 0 && <section class="section container"><div class="section-head"><h2>News</h2><a class="more" href="/news">All news →</a></div><div class="grid" style="--min: 300px">{news.map(n => <NewsCard post={n} />)}</div></section>}
</BaseLayout>
<style>
  .hero { padding-top: clamp(32px, 5vw, 64px); text-align: center; }
  .hero h1 { font-size: clamp(2.4rem, 5.5vw, 4.4rem); letter-spacing: -.05em; line-height: 1.05; margin: 0; }
  .mark { position: relative; display: inline-block; white-space: nowrap; }
  .mark svg { position: absolute; left: 0; bottom: -.08em; width: 100%; height: .22em; overflow: visible; fill: none; stroke: var(--accent); stroke-width: 4; stroke-linecap: round; }
  .hero > p { font-size: var(--step-1); color: var(--ink-3); margin: 16px 0 clamp(28px, 4vw, 44px); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 2.1fr) minmax(270px, 1fr); gap: 16px; text-align: left; }
  .discovery { align-self: start; display: flex; flex-direction: column; gap: 8px; padding: 20px; border-radius: var(--radius-l); background: var(--paper-2); }
  .discovery h2 { font-size: var(--step-1); margin: 0 0 4px; }
  .previews { display: grid; gap: 8px; }
  .preview { display: block; padding: 16px 18px; border-radius: var(--radius); background: var(--card); box-shadow: var(--shadow-s); color: var(--ink); text-decoration: none; transition: box-shadow .15s; }
  .preview:hover { box-shadow: var(--shadow); color: var(--ink); }
  .preview-meta { display: block; font-size: 12px; color: var(--ink-3); margin-bottom: 4px; }
  .preview h3 { font-size: 1.1rem; margin-bottom: 4px; }
  .preview p { color: var(--ink-3); font-size: 13px; line-height: 1.55; margin: 0; }
  .discovery .more { padding: 8px 4px 0; }
  .section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; margin-bottom: 20px; }
  .section-head h2 { margin: 0; font-size: var(--step-3); }
  .more { font-size: 14px; font-weight: 600; text-decoration: none; }
  .more:hover { text-decoration: underline; }
  .papers { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .paper { --tint: var(--c-exam); display: flex; flex-direction: column; padding: 22px 24px; border-radius: var(--radius-l); background: var(--c-exam-soft); }
  .paper--2 { --tint: var(--c-context); background: var(--c-context-soft); }
  .paper--3 { --tint: var(--c-historiography); background: var(--c-historiography-soft); }
  .paper-top { display: flex; justify-content: space-between; margin: 0; font-size: 13px; font-weight: 500; color: var(--ink-2); }
  .paper-top span:first-child { font-weight: 600; color: var(--tint); }
  .paper h3 { font-size: 1.35rem; margin: 10px 0 12px; }
  .paper ul { list-style: none; margin: 0 0 16px; padding: 0; }
  .paper li a { display: flex; justify-content: space-between; gap: 12px; padding: 8px 0; border-top: 1px solid color-mix(in srgb, var(--tint) 18%, transparent); color: var(--ink); text-decoration: none; font-size: 15px; font-weight: 500; }
  .paper li a:hover { color: var(--tint); }
  .paper li span:last-child { flex-shrink: 0; color: var(--ink-3); font-weight: 400; }
  .paper .more { margin-top: auto; color: var(--tint); }
  .source { color: var(--ink-3); font-size: 13px; margin: 16px 0 0; }
  .dept { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; padding-top: 0; }
  .dept .section-head h2 { font-size: var(--step-2); }
  .course-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .course-list a { display: flex; flex-direction: column; padding: 14px 18px; border-radius: var(--radius); box-shadow: var(--shadow-s); color: var(--ink); text-decoration: none; }
  .course-list a:hover { background: var(--paper-2); color: var(--ink); }
  .course-list span:first-child { font: 600 1.02rem var(--font-display); letter-spacing: -.02em; }
  .course-list span:last-child { font-size: 13px; color: var(--ink-3); }
  .section + .section:not(.dept) { padding-top: 0; }
  @media(max-width: 900px) { .hero-grid { grid-template-columns: minmax(0, 1.7fr) minmax(240px, 1fr); } .dept { gap: 32px; } }
  @media(max-width: 700px) { .hero-grid, .dept, .papers { grid-template-columns: 1fr; } .section-head { flex-wrap: wrap; } }
  @media(prefers-reduced-motion: reduce) { .preview { transition: none; } }
</style>
