---
import { getCollection } from 'astro:content';
import Badge from '@/components/Badge.astro';
import TeacherCard from '@/components/TeacherCard.astro';
import TopicCard from '@/components/TopicCard.astro';
import HomeGlobe from '@/features/globe/HomeGlobe';
import { getGlobeData } from '@/features/globe/data';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCourses, getNews, getTeachers, getTopics } from '@/lib/content';
import { formatDate, formatYearRange } from '@/lib/format';
const data = await getGlobeData();
const topics = (await getTopics()).filter(t => t.data.curriculum === '2028');
const glossary = await getCollection('glossary');
const courses = await getCourses();
const teachers = (await getTeachers()).slice(0, 3);
const news = (await getNews()).slice(0, 3);
const featured = topics.slice(0, 6);
const previews = topics.filter(t => t.data.period.start === 1789).slice(0, 3);
const selections = [
  { paper: 1, title: 'Political and economic transitions', description: 'Investigate change through historical sources.', level: 'SL & HL' },
  { paper: 2, title: 'Authoritarian rule', description: 'Explore the emergence, exercise and impact of power.', level: 'SL & HL' },
  { paper: 3, title: 'Europe: revolution & unification', description: 'The French Revolution and the unification of Germany and Italy.', level: 'HL' },
];
---
<BaseLayout>
  <section class="hero" aria-labelledby="hero-title">
    <HomeGlobe client:load {...data} />
    <div class="hero-copy container">
      <p class="eyebrow">IB History · first assessment 2028</p>
      <h1 id="hero-title">Every event has a place.</h1>
      <p class="hero-lede">Explore the world from human origins to today. Each pin opens a focused study note.</p>
      <div class="hero-actions">
        <a class="btn btn--primary" href="/globe?year=1789">Open the globe</a>
        <a class="btn" href="/topics">Browse notes</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <p class="eyebrow">Start here · 1789</p>
        <h2>A world on the edge of change.</h2>
        <p class="muted">Begin as revolution reshaped France. Every note covers one event, in its own time and place.</p>
      </div>
      <ul class="rows">
        {previews.map(t => <li><a class="row" href={`/topics/${t.id}`}>
          <span class="row-meta">{formatYearRange(t.data.period.start, t.data.period.end)} · {t.data.location.place}</span>
          <span class="row-title">{t.data.shortTitle ?? t.data.title}</span>
          <span class="row-text">{t.data.summary}</span>
        </a></li>)}
      </ul>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container">
      <div class="section-head">
        <h2>Course notes</h2>
        <a class="more" href="/topics">All {topics.length} notes →</a>
      </div>
      <div class="grid" style="--min: 300px">{featured.map(t => <TopicCard topic={t} />)}</div>
      <p class="aside">Highlighted sources, key terms with their significance, and self-test questions. <a href="/glossary">{glossary.length} glossary terms →</a></p>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container split">
      <div>
        <h2>One foundation. More depth at HL.</h2>
        <p class="muted">SL and HL share Papers 1 and 2; Higher Level adds a regional study.</p>
        <p class="source">Source: <a href="https://ibo.org/globalassets/new-structure/programmes/dp/pdfs/dp-history-sb-en.pdf">IB History subject brief, first assessment 2028</a>.</p>
      </div>
      <ul class="rows">
        {selections.map(s => <li><a class="row" href={`/topics?level=${s.paper === 3 ? 'HL' : 'SL'}#paper-${s.paper}`}>
          <span class="row-meta"><Badge tone={`paper-${s.paper}`}>Paper {s.paper}</Badge> {s.level}</span>
          <span class="row-title">{s.title}</span>
          <span class="row-text">{s.description}</span>
        </a></li>)}
      </ul>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container split">
      <div>
        <h2>The department</h2>
        <p class="muted">Our courses, the people who teach them, and the guides that support historical enquiry.</p>
        <a class="more" href="/about">About the department →</a>
      </div>
      <div>
        <ul class="rows">
          {courses.map(c => <li><a class="row row--inline" href={`/courses/${c.id}`}>
            <span class="row-title">{c.data.title}</span>
            <span class="row-meta">{c.data.level} · {c.data.grades}{c.data.placeholder ? ' · Sample' : ''}</span>
          </a></li>)}
        </ul>
        <div class="grid teachers" style="--min: 200px">{teachers.map(t => <TeacherCard teacher={t} compact />)}</div>
        <a class="more" href="/teachers">All teachers →</a>
      </div>
    </div>
  </section>

  {news.length > 0 && <section class="section section--alt">
    <div class="container split">
      <div>
        <h2>News</h2>
        <a class="more" href="/news">All news →</a>
      </div>
      <ul class="rows">
        {news.map(n => <li><a class="row row--inline" href={`/news/${n.id}`}>
          <span class="row-title">{n.data.title}{n.data.placeholder && <span class="sample"> · Sample</span>}</span>
          <time class="row-meta" datetime={n.data.date.toISOString()}>{formatDate(n.data.date)}</time>
        </a></li>)}
      </ul>
    </div>
  </section>}
</BaseLayout>
<style>
  .hero { position: relative; }
  .hero-copy { position: absolute; z-index: 4; top: clamp(24px, 5vw, 64px); left: 0; right: 0; pointer-events: none; }
  .hero-copy h1 { font-size: var(--step-5); font-weight: 500; letter-spacing: -0.04em; line-height: 1.02; max-width: 9ch; margin: 0 0 16px; }
  .hero-lede { color: var(--ink-3); font-size: 14px; max-width: 30ch; margin: 0 0 20px; }
  .hero-actions { display: flex; gap: 8px; flex-wrap: wrap; }
  .hero-actions a { pointer-events: auto; }

  .split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); gap: clamp(28px, 6vw, 80px); align-items: start; }
  .split h2 { font-size: var(--step-3); margin-bottom: 12px; }
  .split .muted { font-size: 14px; max-width: 40ch; }
  .source { font-size: 12px; color: var(--ink-3); }
  .source a { color: inherit; }

  .rows { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .row { display: grid; gap: 4px; padding: 16px 0; border-bottom: 1px solid var(--rule); text-decoration: none; color: var(--ink); }
  .row:hover { color: var(--ink); }
  .row:hover .row-title { color: var(--accent); }
  .row--inline { grid-template-columns: minmax(0, 1fr) auto; align-items: baseline; gap: 16px; }
  .row-meta { display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .row-title { font-size: 15px; font-weight: 550; transition: color 0.15s; }
  .row-text { font-size: 13px; color: var(--ink-3); }
  .sample { color: var(--ink-3); font-weight: 400; }

  .section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; margin-bottom: 24px; }
  .section-head h2 { font-size: var(--step-3); margin: 0; }
  .more { display: inline-block; font-size: 13px; color: var(--ink-3); text-decoration: none; }
  .more:hover { color: var(--accent); }
  .aside { margin: 24px 0 0; font-size: 13px; color: var(--ink-3); }
  .aside a { color: var(--ink); text-decoration: none; white-space: nowrap; }
  .aside a:hover { color: var(--accent); }
  .teachers { margin: 24px 0 16px; }

  @media (max-width: 760px) {
    .split { grid-template-columns: 1fr; }
    .row--inline { grid-template-columns: 1fr; gap: 2px; }
    .hero-copy h1 { max-width: none; font-size: var(--step-4); margin-bottom: 8px; }
    .hero-lede { margin-bottom: 12px; }
  }
</style>
