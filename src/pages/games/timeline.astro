---
import BaseLayout from '@/layouts/BaseLayout.astro';
import GameNav from '@/features/games/GameNav.astro';
import TimelineGame from '@/features/games/TimelineGame';
import { getGameCatalogue } from '@/features/games/data';
const catalogue = await getGameCatalogue();
---
<BaseLayout title="Timeline" description="Which came first? Build a timeline of real historical events, one image at a time.">
  <div class="container games-page"><GameNav /><h1 class="game-page-title">Timeline</h1><TimelineGame client:load catalogue={catalogue} /><noscript><p>This game needs JavaScript. Explore the <a href="/topics">study notes</a> instead.</p></noscript></div>
</BaseLayout>
<style>.games-page { padding-bottom: 72px; } .game-page-title { font-size: var(--step--1); font-family: var(--font-sans); color: var(--accent); font-weight: 600; letter-spacing: .05em; text-transform: uppercase; margin-bottom: 24px; }</style>
