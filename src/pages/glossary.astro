---
import { getCollection, getEntries } from 'astro:content';
import PageHeader from '@/components/PageHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTermUsage } from '@/lib/content';

const terms = (await getCollection('glossary')).sort((a, b) =>
  a.data.term.localeCompare(b.data.term, 'en', { sensitivity: 'base' }),
);
const usage = await getTermUsage();
const letterOf = (term: string) => term.normalize('NFKD')[0].toUpperCase();
const letters = [...new Set(terms.map((t) => letterOf(t.data.term)))];
const PAGE_SIZE = 20;
const pages = Math.ceil(terms.length / PAGE_SIZE);
const withRelated = await Promise.all(terms.map(async (t) => ({ t, related: await getEntries(t.data.related) })));
---

<BaseLayout
  title="Glossary"
  description="Key terms for IB History, each with a definition and an explanation of why it matters."
>
  <PageHeader title="Glossary">
    <div class="tools">
      <label class="search">
        <span class="visually-hidden">Filter terms</span>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
          ><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8"></circle><path
            d="m16 16 4.5 4.5"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"></path></svg
        >
        <input type="search" placeholder={`Filter ${terms.length} terms…`} data-filter autocomplete="off" />
      </label>
      <nav class="letters" aria-label="Jump to letter">
        {letters.map((l) => <a href={`#letter-${l}`}>{l}</a>)}
      </nav>
    </div>
  </PageHeader>

  <div class="container glossary">
    {
      letters.map((letter) => (
        <section class="letter-group" id={`letter-${letter}`} data-group>
          <h2 class="letter">{letter}</h2>
          <dl>
            {withRelated
              .filter(({ t }) => letterOf(t.data.term) === letter)
              .map(({ t, related }) => {
                const topics = usage.get(t.id) ?? [];
                return (
                  <div
                    class="entry"
                    id={t.id}
                    data-entry
                    data-text={`${t.data.term} ${t.data.definition} ${t.data.significance}`.toLowerCase()}
                  >
                    <dt>
                      {t.data.term}
                      {t.data.when && <span class="when">{t.data.when}</span>}
                    </dt>
                    <dd>
                      <p>{t.data.definition}</p>
                      <p class="sig">
                        <span class="sig-label">Why it matters</span>
                        {t.data.significance}
                      </p>
                      {(topics.length > 0 || related.length > 0) && (
                        <p class="links">
                          {topics.length > 0 && (
                            <span>
                              Appears in:{' '}
                              {topics.map((tp, i) => (
                                <>
                                  {i > 0 && ', '}
                                  <a href={`/topics/${tp.id}`}>{tp.data.title}</a>
                                </>
                              ))}
                            </span>
                          )}
                          {related.length > 0 && (
                            <span>
                              See also:{' '}
                              {related.map((r, i) => (
                                <>
                                  {i > 0 && ', '}
                                  <a href={`#${r.id}`}>{r.data.term}</a>
                                </>
                              ))}
                            </span>
                          )}
                        </p>
                      )}
                    </dd>
                  </div>
                );
              })}
          </dl>
        </section>
      ))
    }
    <p class="no-results" hidden data-no-results>No terms match that filter.</p>
    <nav class="pager" aria-label="Glossary pages" hidden data-pager>
      <button type="button" data-step="-1">← Previous</button>
      {Array.from({ length: pages }, (_, i) => <button type="button" data-page={i}>{i + 1}</button>)}
      <button type="button" data-step="1">Next →</button>
    </nav>
  </div>
</BaseLayout>

<script>
  const PAGE_SIZE = 20;
  const input = document.querySelector<HTMLInputElement>('[data-filter]')!;
  const entries = [...document.querySelectorAll<HTMLElement>('[data-entry]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-group]')];
  const none = document.querySelector<HTMLElement>('[data-no-results]')!;
  const pager = document.querySelector<HTMLElement>('[data-pager]')!;
  const pageButtons = [...pager.querySelectorAll<HTMLButtonElement>('[data-page]')];
  const last = pageButtons.length - 1;
  let page = Math.min(last, Math.max(0, Number(new URLSearchParams(location.search).get('page') ?? 1) - 1 || 0));

  // Searching shows every match; otherwise only the current page's terms.
  function render() {
    const q = input.value.trim().toLowerCase();
    let shown = 0;
    entries.forEach((e, i) => {
      e.hidden = q ? !e.dataset.text!.includes(q) : Math.floor(i / PAGE_SIZE) !== page;
      if (!e.hidden) shown++;
    });
    for (const g of groups) g.hidden = !g.querySelector('[data-entry]:not([hidden])');
    none.hidden = shown > 0;
    pager.hidden = !!q;
    pageButtons.forEach((b, i) => (i === page ? b.setAttribute('aria-current', 'page') : b.removeAttribute('aria-current')));
    pager.querySelector<HTMLButtonElement>('[data-step="-1"]')!.disabled = page === 0;
    pager.querySelector<HTMLButtonElement>('[data-step="1"]')!.disabled = page === last;
  }

  function goTo(next: number) {
    page = next;
    const url = new URL(location.href);
    url.hash = '';
    if (page) url.searchParams.set('page', String(page + 1));
    else url.searchParams.delete('page');
    history.replaceState(null, '', url);
    render();
    document.querySelector('.glossary')!.scrollIntoView();
  }

  // Letter links, "See also" links and popover links open the page holding their target.
  function showHash() {
    const target = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
    const entry = target?.matches('[data-entry]') ? target : target?.querySelector<HTMLElement>('[data-entry]');
    if (!entry) return;
    input.value = '';
    page = Math.floor(entries.indexOf(entry) / PAGE_SIZE);
    render();
    for (const e of entries) e.classList.toggle('is-target', e === target);
    target!.scrollIntoView();
  }

  input.addEventListener('input', render);
  pager.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('button');
    if (b) goTo(b.dataset.page ? Number(b.dataset.page) : page + Number(b.dataset.step));
  });
  window.addEventListener('hashchange', showHash);
  render();
  showHash();
</script>

<style>
  .tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
    margin-top: 20px;
  }
  .search {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1 1 280px;
    max-width: 420px;
    padding: 12px 18px;
    border-radius: var(--radius);
    background: var(--paper-2);
    color: var(--ink-3);
  }
  .search:focus-within {
    box-shadow: 0 0 0 2px var(--accent);
  }
  .search input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    font: inherit;
    color: var(--ink);
    outline: none;
  }
  .letters {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .letters a {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    font-family: var(--font-display);
    font-weight: 600;
    text-decoration: none;
    color: var(--ink-2);
  }
  .letters a:hover {
    background: var(--paper-2);
    color: var(--ink);
  }
  .glossary {
    padding-bottom: clamp(48px, 7vw, 96px);
  }
  .letter-group {
    padding-top: 24px;
  }
  .letter-group[hidden] {
    display: none;
  }
  .letter {
    font-size: var(--step-2);
    color: var(--ink-3);
    margin: 0 0 4px;
    scroll-margin-top: calc(var(--header-h) + 24px);
  }
  dl {
    margin: 0;
  }
  .entry {
    display: grid;
    grid-template-columns: minmax(0, 14em) minmax(0, 1fr);
    gap: 6px 32px;
    padding: 16px 12px;
    margin-inline: -12px;
    border-radius: var(--radius);
    border-bottom: 1px solid var(--rule);
    scroll-margin-top: calc(var(--header-h) + 24px);
  }
  .entry:last-child {
    border-bottom: 0;
  }
  .entry[hidden] {
    display: none;
  }
  .entry.is-target {
    background: var(--brass-soft);
  }
  dt {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .when {
    display: block;
    margin-top: 2px;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--ink-3);
  }
  dd {
    margin: 0;
  }
  dd p {
    margin: 0 0 8px;
  }
  .sig {
    color: var(--ink-2);
  }
  .sig-label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    font-size: 0.88rem;
    color: var(--ink-3);
  }
  .no-results {
    padding: 40px 0;
    text-align: center;
    color: var(--ink-3);
  }
  .pager {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px;
    margin-top: 32px;
  }
  .pager[hidden] {
    display: none;
  }
  .pager button {
    min-width: 40px;
    height: 40px;
    padding: 0 12px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--ink-2);
    font-weight: 500;
    cursor: pointer;
  }
  .pager button:hover:not(:disabled) {
    background: var(--paper-2);
    color: var(--ink);
  }
  .pager button[aria-current] {
    background: var(--ink);
    color: var(--paper);
  }
  .pager button:disabled {
    color: var(--ink-3);
    opacity: 0.5;
    cursor: default;
  }
  @media (max-width: 720px) {
    .entry {
      grid-template-columns: 1fr;
    }
  }
</style>
