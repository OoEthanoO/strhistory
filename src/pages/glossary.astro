---
import { getCollection, getEntries } from 'astro:content';
import PageHeader from '@/components/PageHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTermUsage } from '@/lib/content';

const terms = (await getCollection('glossary')).sort((a, b) =>
  a.data.term.localeCompare(b.data.term, 'en', { sensitivity: 'base' }),
);
const usage = await getTermUsage();
const letterOf = (term: string) => term.normalize('NFKD')[0].toUpperCase();
const letters = [...new Set(terms.map((t) => letterOf(t.data.term)))];
const withRelated = await Promise.all(terms.map(async (t) => ({ t, related: await getEntries(t.data.related) })));
---

<BaseLayout
  title="Glossary"
  description="Key terms for IB History, each with a definition and an explanation of why it matters."
>
  <div class="glossary-header">
  <PageHeader title="Glossary">
    <div class="tools">
      <label class="search">
        <span class="visually-hidden">Filter terms</span>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"
          ><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8"></circle><path
            d="m16 16 4.5 4.5"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"></path></svg
        >
        <input type="search" placeholder={`Filter ${terms.length} terms…`} data-filter autocomplete="off" />
      </label>
    </div>
  </PageHeader>
  </div>

  <div class="container glossary-layout">
    <nav class="letters" aria-label="Jump to letter">
      {letters.map((l) => <a href={`#letter-${l}`}>{l}</a>)}
    </nav>
    <div class="glossary">
    {
      letters.map((letter) => (
        <section class="letter-group" id={`letter-${letter}`} data-group>
          <h2 class="letter">{letter}</h2>
          <dl>
            {withRelated
              .filter(({ t }) => letterOf(t.data.term) === letter)
              .map(({ t, related }) => {
                const topics = usage.get(t.id) ?? [];
                return (
                  <div
                    class="entry"
                    id={t.id}
                    data-entry
                    data-text={`${t.data.term} ${t.data.definition} ${t.data.significance}`.toLowerCase()}
                  >
                    <dt>
                      {t.data.term}
                      {t.data.when && <span class="when">{t.data.when}</span>}
                    </dt>
                    <dd>
                      <p>{t.data.definition}</p>
                      <p class="sig">
                        <span class="sig-label">Why it matters</span>
                        {t.data.significance}
                      </p>
                      {(topics.length > 0 || related.length > 0) && (
                        <p class="links">
                          {topics.length > 0 && (
                            <span>
                              Appears in:{' '}
                              {topics.map((tp, i) => (
                                <>
                                  {i > 0 && ', '}
                                  <a href={`/topics/${tp.id}`}>{tp.data.title}</a>
                                </>
                              ))}
                            </span>
                          )}
                          {related.length > 0 && (
                            <span>
                              See also:{' '}
                              {related.map((r, i) => (
                                <>
                                  {i > 0 && ', '}
                                  <a href={`#${r.id}`}>{r.data.term}</a>
                                </>
                              ))}
                            </span>
                          )}
                        </p>
                      )}
                    </dd>
                  </div>
                );
              })}
          </dl>
        </section>
      ))
    }
    <p class="no-results" hidden data-no-results>No terms match that filter.</p>
    </div>
  </div>
</BaseLayout>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-filter]')!;
  const entries = [...document.querySelectorAll<HTMLElement>('[data-entry]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-group]')];
  const none = document.querySelector<HTMLElement>('[data-no-results]')!;
  const index = document.querySelector<HTMLElement>('.letters')!;
  const layout = document.querySelector<HTMLElement>('.glossary-layout')!;

  function positionIndex() {
    const bounds = layout.getBoundingClientRect();
    const style = getComputedStyle(layout);
    index.style.setProperty('--index-top', `${bounds.top + window.scrollY}px`);
    index.style.setProperty('--index-left', `${bounds.left + parseFloat(style.paddingLeft)}px`);
    index.style.setProperty('--index-width', style.gridTemplateColumns.split(' ')[0]);
    index.dataset.fixed = '';
  }
  positionIndex();
  window.addEventListener('resize', positionIndex);
  document.fonts.ready.then(positionIndex);

  // All terms stay visible unless a search filters them.
  function render() {
    const q = input.value.trim().toLowerCase();
    let shown = 0;
    entries.forEach((e) => {
      e.hidden = !e.dataset.text!.includes(q);
      if (!e.hidden) shown++;
    });
    for (const g of groups) g.hidden = !g.querySelector('[data-entry]:not([hidden])');
    none.hidden = shown > 0;
  }

  // Anchor links also reveal their target when a search is active.
  function showHash() {
    const target = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
    const entry = target?.matches('[data-entry]') ? target : target?.querySelector<HTMLElement>('[data-entry]');
    if (!entry) return;
    input.value = '';
    render();
    for (const e of entries) e.classList.toggle('is-target', e === target);
    target!.scrollIntoView();
  }

  input.addEventListener('input', render);
  input.addEventListener('blur', () => {
    queueMicrotask(() => input.focus({ preventScroll: true }));
  });
  input.addEventListener('keydown', (event) => {
    if (event.key === 'Tab') event.preventDefault();
  });
  document.addEventListener('keydown', (event) => {
    if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'f') {
      event.preventDefault();
      input.focus();
      input.select();
      return;
    }
  });
  window.addEventListener('hashchange', showHash);
  render();
  showHash();
  input.focus({ preventScroll: true });
</script>

<style>
  .glossary-header :global(.page-head) { padding-bottom: 8px; margin-bottom: 8px; }
  .tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
    margin-top: 20px;
  }
  .search {
    display: flex;
    align-items: center;
    gap: 10px;
    flex: 1 1 280px;
    max-width: 420px;
    padding: 12px 18px;
    border-radius: var(--radius);
    background: var(--paper-2);
    color: var(--ink-3);
  }
  .search input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    font: inherit;
    color: var(--ink);
    outline: none;
  }
  .letters {
    position: sticky;
    top: var(--header-h);
    align-self: start;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    max-height: calc(100dvh - var(--header-h) - 32px);
    overflow-y: auto;
    scrollbar-width: thin;
    overscroll-behavior: contain;
    padding: 4px;
    border-radius: var(--radius-s);
  }
  .letters a {
    display: grid;
    place-items: center;
    width: 100%;
    max-width: 32px;
    min-height: 28px;
    flex-shrink: 0;
    border-radius: var(--radius-s);
    font-family: var(--font-serif);
    font-weight: 600;
    text-decoration: none;
    color: var(--ink-2);
  }
  .letters[data-fixed] {
    position: fixed;
    top: var(--index-top);
    left: var(--index-left);
    width: var(--index-width);
    max-height: max(28px, calc(100dvh - var(--index-top) - 16px));
  }
  .letters a:hover {
    background: var(--card);
    color: var(--ink);
  }
  .glossary-layout {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr);
    gap: 32px;
    align-items: start;
  }
  .glossary {
    grid-column: 2;
    padding-bottom: clamp(48px, 7vw, 96px);
  }
  .letter-group {
    scroll-margin-top: calc(var(--header-h) + 16px);
  }
  .letter-group:not([hidden]) ~ .letter-group { margin-top: 24px; }
  .letter-group[hidden] {
    display: none;
  }
  .letter {
    position: sticky;
    top: var(--header-h);
    z-index: 1;
    padding: 8px 12px;
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-serif);
    font-size: var(--step-5);
    color: var(--ink-3);
    margin: 0 -12px 4px;
    scroll-margin-top: calc(var(--header-h) + 24px);
  }
  dl {
    margin: 0;
  }
  .entry {
    display: grid;
    grid-template-columns: minmax(0, 14em) minmax(0, 1fr);
    gap: 6px 32px;
    padding: 16px 12px;
    margin-inline: -12px;
    border-bottom: 1px solid var(--rule);
    scroll-margin-top: calc(var(--header-h) + 24px);
  }
  .entry:last-child {
    border-bottom: 0;
  }
  .entry[hidden] {
    display: none;
  }
  .entry.is-target {
    background: var(--brass-soft);
  }
  dt {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .when {
    display: block;
    margin-top: 2px;
    font-family: var(--font-sans);
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--ink-3);
  }
  dd {
    margin: 0;
  }
  dd p {
    margin: 0 0 8px;
  }
  .sig {
    color: var(--ink-2);
  }
  .sig-label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    font-size: 0.88rem;
    color: var(--ink-3);
  }
  .no-results {
    padding: 40px 0;
    text-align: center;
    color: var(--ink-3);
  }
  @media (max-width: 720px) {
    .glossary-layout { grid-template-columns: 40px minmax(0, 1fr); gap: 16px; }
    .letters a { max-width: 28px; min-height: 28px; }
    .entry {
      grid-template-columns: 1fr;
    }
  }
</style>
