---
import { getGlobeData } from '@/features/globe/data';
import GlobeExplorer from '@/features/globe/GlobeExplorer';
import BaseLayout from '@/layouts/BaseLayout.astro';
const data = await getGlobeData();
---

<BaseLayout title="Globe" description="Explore human history on an interactive globe, move through time, and open individual IB History notes in the places where events happened." immersive>
  <GlobeExplorer client:load {...data} />
  <noscript><div class="globe-noscript"><p>Enable JavaScript to rotate the globe and change years. Every note is also available in the <a href="/topics">notes library</a>.</p></div></noscript>
</BaseLayout>

<style>
  .globe-noscript { position: fixed; z-index: 20; bottom: 20px; left: 20px; right: 20px; padding: 16px; background: var(--paper); color: var(--ink); border-radius: var(--radius); }
</style>
