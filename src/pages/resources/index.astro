---
import PageHeader from '@/components/PageHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getGuides } from '@/lib/content';

const guides = await getGuides();
const categories = ['Assessment', 'Skills', 'Research'] as const;
---

<BaseLayout
  title="Resources"
  description="Study guides for IB History: exam papers, source analysis, essay writing, the internal assessment and the extended essay."
>
  <PageHeader title="Study guides" />
  <div class="container list">
    {
      categories.map((cat) => {
        const items = guides.filter((g) => g.data.category === cat);
        return (
          items.length > 0 && (
            <section class="cat">
              <h2>{cat}</h2>
              <div class="grid" style="--min: 300px">
                {items.map((g) => (
                  <a class="guide" href={`/resources/${g.id}`}>
                    <h3>{g.data.title}</h3>
                    <p>{g.data.summary}</p>
                  </a>
                ))}
              </div>
            </section>
          )
        );
      })
    }
  </div>
</BaseLayout>

<style>
  .list {
    padding-bottom: clamp(48px, 7vw, 96px);
  }
  .cat + .cat {
    margin-top: 40px;
  }
  .cat h2 {
    font-size: var(--step-1);
    color: var(--ink-3);
  }
  .guide {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px 24px;
    border-radius: var(--radius-l);
    background: var(--card);
    box-shadow: var(--shadow-s);
    color: var(--ink);
    text-decoration: none;
    transition: box-shadow 0.15s;
  }
  .guide:hover {
    box-shadow: var(--shadow);
    color: var(--ink);
  }
  .guide h3 {
    margin: 0;
    font-size: 1.2rem;
  }
  .guide p {
    margin: 0;
    color: var(--ink-3);
    font-size: 0.94rem;
  }
</style>
