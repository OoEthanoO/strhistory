---
import { nav, site } from '@/config/site';
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  /** `immersive` = transparent header floating over the full-screen globe. */
  variant?: 'default' | 'immersive';
}
const { variant = 'default' } = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class:list={['site-header', variant]}>
  <div class="inner">
    <a class="brand" href="/" aria-label={`${site.name} — home`}>
      <Logo size={22} />
      <span class="brand-name">{site.name}</span>
    </a>

    <nav class="primary" aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="actions">
      <ThemeToggle />
      <button
        type="button"
        class="menu-btn"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open menu"
        data-menu-btn
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="mobile-nav" aria-label="Main" hidden data-mobile-nav>
    <ul>
      {
        nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
      <li><a href="/about" aria-current={isActive('/about') ? 'page' : undefined}>About</a></li>
    </ul>
  </nav>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const panel = document.querySelector<HTMLElement>('[data-mobile-nav]');
  if (btn && panel) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      panel.hidden = !open;
    };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => e.key === 'Escape' && set(false));
    matchMedia('(min-width: 961px)').addEventListener('change', (e) => e.matches && set(false));
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--overlay);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--rule);
  }
  .inner {
    display: flex;
    align-items: center;
    gap: 24px;
    height: var(--header-h);
    max-width: var(--container);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
    text-decoration: none;
    flex-shrink: 0;
  }
  .brand:hover {
    color: var(--ink);
  }
  .brand-name {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .primary {
    margin-left: auto;
  }
  .primary ul,
  .mobile-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .primary ul {
    display: flex;
    gap: 2px;
  }
  .primary a,
  .mobile-nav a {
    display: block;
    padding: 6px 10px;
    border-radius: var(--radius-s);
    color: var(--ink-3);
    text-decoration: none;
    font-size: 13px;
    font-weight: 450;
    transition: color 0.15s;
  }
  .primary a:hover {
    color: var(--ink);
  }
  .primary a[aria-current='page'] {
    color: var(--ink);
    font-weight: 550;
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .menu-btn {
    display: none;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: var(--radius);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    padding: 0;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 4px;
  }
  .menu-btn span {
    display: block;
    width: 16px;
    height: 1.5px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 0.2s var(--ease), opacity 0.2s;
  }
  .menu-btn[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(5.5px) rotate(45deg);
  }
  .menu-btn[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }
  .menu-btn[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-5.5px) rotate(-45deg);
  }

  .mobile-nav {
    border-top: 1px solid var(--rule);
    background: var(--paper);
    padding: 8px var(--gutter) 16px;
  }
  .mobile-nav a {
    padding: 12px 0;
    font-size: 15px;
    color: var(--ink-2);
    border-bottom: 1px solid var(--rule);
    border-radius: 0;
  }
  .mobile-nav a[aria-current='page'] {
    color: var(--ink);
    font-weight: 550;
  }

  @media (max-width: 960px) {
    .primary {
      display: none;
    }
    .actions {
      margin-left: auto;
    }
    .menu-btn {
      display: inline-flex;
    }
  }

  /* Immersive: floats over the full-screen globe without a bar of its own. */
  .immersive {
    position: fixed;
    inset: 0 0 auto 0;
    background: transparent;
    backdrop-filter: none;
    border-bottom: 0;
  }
  .immersive .inner {
    max-width: none;
    padding-inline: 18px;
  }
  .immersive .primary ul,
  .immersive .brand,
  .immersive .actions :global(.theme-toggle),
  .immersive .menu-btn {
    background: var(--gx-panel, var(--overlay));
    border: 1px solid var(--rule);
    border-radius: var(--radius-l);
    backdrop-filter: blur(12px);
  }
  .immersive .brand {
    height: 38px;
    padding: 0 12px 0 10px;
  }
  .immersive .primary ul {
    padding: 3px;
  }
  .immersive .menu-btn {
    width: 38px;
    height: 38px;
  }
  .immersive .mobile-nav {
    margin: 0 18px;
    border: 1px solid var(--rule);
    border-radius: var(--radius-l);
  }
</style>
