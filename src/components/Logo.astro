---
/** Globe-and-pin mark. Inherits colour from `currentColor`; the pin uses the accent. */
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  fill="none"
  aria-hidden="true"
>
  <circle cx="16" cy="16" r="12.5" stroke="currentColor" stroke-width="1.6"></circle>
  <ellipse cx="16" cy="16" rx="5.4" ry="12.5" stroke="currentColor" stroke-width="1.2" opacity="0.7"></ellipse>
  <path d="M3.8 12h24.4M3.8 20h24.4" stroke="currentColor" stroke-width="1.2" opacity="0.7"></path>
  <path
    d="M21.5 4.5c-2.6 0-4.5 1.9-4.5 4.4 0 3.2 4.5 7.6 4.5 7.6s4.5-4.4 4.5-7.6c0-2.5-1.9-4.4-4.5-4.4Z"
    fill="var(--accent)"
    stroke="var(--paper)"
    stroke-width="1.2"></path>
  <circle cx="21.5" cy="8.9" r="1.5" fill="var(--paper)"></circle>
</svg>
