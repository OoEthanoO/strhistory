---
import { site } from '@/config/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <p>
      © {year} {site.department}{site.school && `, ${site.school}`}
      {site.email && <> · <a href={`mailto:${site.email}`}>{site.email}</a></>}
      · <a href="/about">About</a>
      · <a href="/admin">Teacher editor</a>
    </p>
    <p>
      Historical borders from <a href="https://github.com/aourednik/historical-basemaps">historical-basemaps</a>
      (GPL-3.0), approximate especially for earlier periods.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--rule);
    color: var(--ink-3);
    font-size: 0.85rem;
    margin-top: auto;
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 32px;
    padding-block: 20px 28px;
  }
  p {
    margin: 0;
  }
  a {
    color: inherit;
  }
  a:hover {
    color: var(--ink);
  }
</style>
