---
import { footerNav, site } from '@/config/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <p class="about">
      <span class="name">{site.name}</span>
      {site.department}{site.school && `, ${site.school}`}
      {site.email && <> · <a href={`mailto:${site.email}`}>{site.email}</a></>}
    </p>
    <nav aria-label="Footer">
      <ul>
        {footerNav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
  </div>
  <div class="container legal">
    <p>
      © {year} {site.department}. Historical borders from
      <a href="https://github.com/aourednik/historical-basemaps">historical-basemaps</a> (GPL-3.0) — approximate,
      especially for earlier periods.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--rule);
    color: var(--ink-3);
    font-size: 12px;
    margin-top: auto;
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 32px;
    padding-block: 28px 12px;
  }
  .about {
    margin: 0;
  }
  .name {
    color: var(--ink);
    font-weight: 600;
    margin-right: 8px;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
  }
  a {
    color: var(--ink-3);
    text-decoration: none;
  }
  a:hover {
    color: var(--ink);
  }
  .legal {
    padding-block: 0 28px;
    font-size: 11px;
  }
  .legal p {
    margin: 0;
  }
  .legal a {
    text-decoration: underline;
    text-decoration-color: var(--rule-strong);
  }
</style>
