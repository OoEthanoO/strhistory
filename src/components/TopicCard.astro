---
/** Card linking to a topic's notes. Used on the home page, topic index and "related topics". */
import { getEntry } from 'astro:content';
import type { Topic } from '@/lib/content';
import { formatYearRange } from '@/lib/format';
import Badge from './Badge.astro';

interface Props {
  topic: Topic;
  headingLevel?: 'h2' | 'h3';
}

const { topic, headingLevel: Heading = 'h3' } = Astro.props;
const unit = await getEntry(topic.data.unit);
const paper = unit?.data.paper ?? 2;
---

<a class="topic-card" href={`/topics/${topic.id}`}>
  <div class="top">
    <Badge tone={`paper-${paper}`}>Paper {paper}</Badge>
    <span class="years">{formatYearRange(topic.data.period.start, topic.data.period.end)}</span>
  </div>
  <p class="scope">{topic.data.curriculum === 'archive' ? 'Earlier syllabus archive' : '2028 course'} · {topic.data.level === 'HL' ? 'HL only' : 'SL & HL'}</p>
  <Heading class="title">{topic.data.title}</Heading>
  <p class="summary">{topic.data.summary}</p>
  <p class="foot">
    <span class="place">{topic.data.location.place}</span>
    <span class="go" aria-hidden="true">→</span>
  </p>
</a>

<style>
  .topic-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    height: 100%;
    padding: 18px 20px;
    border-radius: var(--radius-l);
    border: 1px solid var(--rule);
    background: var(--card);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.15s;
  }
  .topic-card:hover {
    border-color: var(--ink-3);
    color: var(--ink);
  }
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .years {
    font-size: 12px;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .scope {
    margin: 0;
    color: var(--ink-3);
    font-size: 11px;
  }
  .title {
    margin: 4px 0 0;
    font-size: 1.05rem;
    font-weight: 550;
    line-height: 1.3;
  }
  .summary {
    margin: 0;
    color: var(--ink-3);
    font-size: 13px;
    line-height: 1.55;
    flex: 1;
  }
  .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 4px 0 0;
    font-size: 12px;
    color: var(--ink-3);
  }
  .go {
    color: var(--ink-3);
    font-size: 14px;
    transition: transform 0.2s var(--ease);
  }
  .topic-card:hover .go {
    color: var(--accent);
    transform: translateX(3px);
  }
</style>
